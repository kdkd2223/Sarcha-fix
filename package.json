{
  "name": "arca13-admin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create arca13-admin-db",
    "db:migrate": "wrangler d1 execute arca13-admin-db --file=./migrations/0001_init.sql",
    "db:migrate:local": "wrangler d1 execute arca13-admin-db --local --file=./migrations/0001_init.sql"
  },
  "devDependencies": {
    "wrangler": "^3.78.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3"
  }
}
